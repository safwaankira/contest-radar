{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": { "api/*.js": { "maxDuration": 120 } },
  "headers": [
    { "source": "/feed/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
