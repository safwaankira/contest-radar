{
  "name": "Contest Radar",
  "description": "Open crypto contests and bounties (GitHub, poidh, X, Reddit), read and ranked daily by an agent that pays for its own data on Celo. Scored for prize, deadline, effort, risk flags and competition.",
  "homepage": "https://contest-radar-celo.vercel.app",
  "repository": "https://github.com/safwaankira/contest-radar",
  "license": "MIT",
  "category": "opportunities",
  "audience": [
    "crypto creators",
    "bounty hunters",
    "coding agents",
    "agents that buy data over x402"
  ],
  "endpoints": {
    "feed": "https://contest-radar-celo.vercel.app/feed/latest.json",
    "csv": "https://contest-radar-celo.vercel.app/feed/latest.csv",
    "rss": "https://contest-radar-celo.vercel.app/feed/latest.xml",
    "manifest": "https://contest-radar-celo.vercel.app/feed/manifest.json",
    "schema": "https://contest-radar-celo.vercel.app/feed/schema.json",
    "llms": "https://contest-radar-celo.vercel.app/llms.txt",
    "ledger": "https://contest-radar-celo.vercel.app/feed/ledger.json",
    "anchors": "https://contest-radar-celo.vercel.app/feed/anchors.json",
    "paid_scan": "https://contest-radar-celo.vercel.app/api/scan",
    "erc8004_registration": "https://contest-radar-celo.vercel.app/agent.json"
  },
  "capabilities": [
    "daily contest and bounty shortlist from GitHub, poidh, X and Reddit",
    "deadline, effort and competition (crowded) scoring",
    "scam and key-request risk flags",
    "daily GitHub bounty shortlist",
    "payout signal scoring",
    "opportunity class and effort-score filtering",
    "Base/USDC/x402/MergeWork rail detection",
    "payout address extraction",
    "agent-readable JSON and CSV exports",
    "RSS feed export for subscriptions",
    "zero-dependency shortlist CLI",
    "zero-dependency MCP stdio server for bounty search tools",
    "x402 paid personal scan on Celo (USDC, USD\u20ae, USA\u20ae)",
    "agent pays its own data through buy on Celo; receipts published",
    "feed hash anchored onchain daily"
  ],
  "integration": {
    "cli": "npm run shortlist -- --min-score 50 --require-amount --require-rail --format markdown",
    "quick_win_cli": "npm run shortlist -- --min-score 30 --opportunity quick-win --max-effort-score 30 --format markdown",
    "mcp_stdio": "node scripts/mcp-server.mjs",
    "mcp_tools": [
      "search_bounties",
      "get_bounty"
    ],
    "docs": "https://github.com/safwaankira/contest-radar#readme",
    "paid_api": "https://contest-radar-celo.vercel.app/api/scan"
  },
  "limitations": [
    "Scores are heuristic triage signals, not payout guarantees.",
    "Consumers must verify issue terms, sponsor reputation, and payment rules before doing work.",
    "Do not use the feed for automated spam comments, bulk outreach, or misleading bounty claims."
  ],
  "payments": {
    "protocol": "x402 v2",
    "scheme": "exact",
    "network": "eip155:42220",
    "assets": [
      "USDC",
      "USDT",
      "USAT"
    ],
    "price_usd": "0.05",
    "endpoint": "https://contest-radar-celo.vercel.app/api/scan"
  }
}
